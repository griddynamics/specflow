{
  "name": "typescript-lint-kit",
  "private": true,
  "type": "module",
  "description": "Project-agnostic ESLint, stylelint, semgrep, knip, Prettier, tsconfig, Vitest and Size Limit validations for TypeScript + React code bases.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "node run.mjs",
    "selftest": "node --test \"eslint-rules/**/*.test.mjs\" \"stylelint/*.test.mjs\" \"scripts/*.test.mjs\" \"size-limit/*.test.mjs\" \"config.test.mjs\" \"run.test.mjs\"",
    "selftest:semgrep": "uv run semgrep --test --metrics=off --disable-version-check --config semgrep/ semgrep/fixtures/ && uv run semgrep --test --metrics=off --disable-version-check --config semgrep-ds/ semgrep-ds/fixtures/",
    "selftest:semgrep-validate": "uv run semgrep --validate --metrics=off --disable-version-check --config semgrep/ && uv run semgrep --validate --metrics=off --disable-version-check --config semgrep-ds/",
    "selflint": "eslint --config eslint.config.mjs --no-inline-config --report-unused-disable-directives-severity error --max-warnings 0 .",
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "build:banned-terms": "node scripts/build-banned-terms.mjs",
    "build:ds-rules": "node scripts/build-ds-rules.mjs"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.19.0",
    "@eslint/js": "9.39.5",
    "@size-limit/file": "13.1.1",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-query": "5.102.8",
    "@types/node": "24.13.4",
    "@types/react": "18.3.31",
    "@typescript-eslint/utils": "8.70.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-barrel-files": "3.0.1",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.3.0",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "size-limit": "13.1.1",
    "stylelint": "16.26.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "vitest-fail-on-console": "0.10.1"
  }
}
