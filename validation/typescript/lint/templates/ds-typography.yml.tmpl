# Design system: type roles (page title, section header, fluid display type, monospace) are
# implemented once and referenced, never re-invented at a call site.
#
# Generated by scripts/build-ds-rules.mjs from templates/ds-typography.yml.tmpl and a design-system
# facts file (design-system.example.json); edit the facts file and rebuild instead of editing this
# file. Facts read: primitivesDir, pageHeaderFile, headerFiles, headerComponentNames,
# typeRoleFields, tokens.monoFont, monoClasses, monoComponents, identifierFields.
rules:
  - id: ds-no-h1-outside-page-header
    message: >-
      `<h1>` outside the page-header primitive. The page title is a single primitive: render the
      page header and pass its title, so every screen keeps the same page-title type role.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@pageHeaderFile@@'
    patterns:
      - pattern-either:
          - pattern: <h1 ...>...</h1>
          - pattern: <$C as="h1" ...>...</$C>

  - id: ds-no-hardcoded-heading-font-size
    message: >-
      Hardcoded font size on a heading element. Heading type is a token role (page title, section
      header, caps label), and a screen does not pick its own. Render the header primitive
      instead of styling a heading by hand.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        @@list:headerFiles@@
    patterns:
      - pattern-either:
          - pattern: '<$H ... style={{..., fontSize: $V}} ...>...</$H>'
          - pattern: '<$H ... style={{..., fontSize: $V}} ... />'
      - metavariable-regex:
          metavariable: $H
          regex: '^h[1-6]$'

  - id: ds-no-hardcoded-header-style-font-size
    message: >-
      Hardcoded font size in a header/title style object. The header type roles own heading type;
      a local style constant that sets `fontSize` for a header re-opens the size drift between
      screens. Delete the constant and render the header primitive.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        @@list:headerFiles@@
    patterns:
      - pattern-either:
          - pattern: 'const $NAME = {..., fontSize: $V};'
          - pattern: 'const $NAME: $T = {..., fontSize: $V};'
      - metavariable-regex:
          metavariable: $NAME
          regex: '(?i)^[a-z0-9_]*(title|header|heading)[a-z0-9_]*$'

  - id: ds-no-duplicate-header-component
    message: >-
      `$NAME` is a second header component outside the primitives directory. The page header,
      section header and section title have exactly one implementation each; a domain-flavoured
      copy is how the page-title drift returns. Compose the primitive instead.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@primitivesDir@@/**'
    patterns:
      - pattern-either:
          - pattern: 'function $NAME(...) { ... }'
          - pattern: const $NAME = ...
      - metavariable-regex:
          metavariable: $NAME
          regex: '^[A-Z][A-Za-z0-9]*(@@alt:headerComponentNames@@)$'

  - id: ds-fluid-type-at-call-site
    message: >-
      A fluid `clamp()` font size declared at a call site. A fluid type role is implemented once,
      as a shared class, not re-derived per surface; a second clamp expression is a second
      definition of the same role, and the two drift. Apply the shared type-role class.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
    pattern-regex: "fontSize:\\s*[`'\"]clamp\\("

  - id: ds-type-role-font-size-at-call-site
    message: >-
      An element that renders a type-role text field (`$F`) declares its own `fontSize` or `font`
      inline. A type role is one shared class, so the size comes from that class and never from
      the element that renders the field. Remove the inline size and apply the shared type-role
      class.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
    patterns:
      - pattern-either:
          - pattern: '<$EL ... style={{..., fontSize: $V, ...}} ...>{$X.$F}</$EL>'
          - pattern: '<$EL ... style={{..., font: $V, ...}} ...>{$X.$F}</$EL>'
          - pattern: '<$EL ... style={{..., fontSize: $V, ...}} ...>{$F}</$EL>'
          - pattern: '<$EL ... style={{..., font: $V, ...}} ...>{$F}</$EL>'
      - metavariable-regex:
          metavariable: $F
          regex: '^(@@alt:typeRoleFields@@)$'

  - id: ds-monospace-outside-the-mono-token
    message: >-
      Monospace font stack `$V` written at the call site. The monospace family is a token, and a
      component references the role rather than spelling out the family, as it does for colour; a
      call site that restates a family or a fallback is a second source of truth for it. Use the
      monospace class or `var(@@tokens.monoFont@@)`.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
    patterns:
      - pattern-either:
          - patterns:
              - pattern: '$K: "$V"'
              - metavariable-regex:
                  metavariable: $K
                  regex: '^fontFamily$'
          - patterns:
              - pattern: 'const $K = "$V";'
              - metavariable-regex:
                  metavariable: $K
                  regex: '.*(FONT|Font|font).*'
      - metavariable-regex:
          metavariable: $V
          regex: '.*([Mm]onospace|ui-monospace).*'

  - id: ds-identifier-rendered-without-monospace
    message: >-
      `$X` is an identifier field that is always shown monospace, so a person tells an identifier
      from prose at a glance, and it is rendered here as plain text, in an element that carries
      neither a monospace class nor a monospace font family. Render it through the property-table
      or table-cell primitive that applies the treatment, or put the monospace class on the
      element that carries the value.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '@@primitivesDir@@/**'
    patterns:
      - pattern-either:
          - pattern: '<$EL ...>{$X}</$EL>'
          - patterns:
              - pattern-either:
                  - pattern: '<$EL ... label=$L ... value={$X} ... />'
                  - pattern: '<$EL ... value={$X} ... label=$L ... />'
              - pattern-not: '<$EL ... mono ... />'
              - pattern-not: '<$EL ... mono={true} ... />'
          - patterns:
              - pattern: '{..., label: $L, ..., value: $X, ...}'
              - pattern-not: '{..., mono: true, ...}'
              # A choice control's option: its `value` is the submitted key, never shown.
              - pattern-not-inside: '<$EL ... options={...} ... />'
              - pattern-not-inside: '{..., options: [...], ...}'
      - metavariable-regex:
          metavariable: $X
          regex: '^([A-Za-z_$][A-Za-z0-9_$]*[.?]{1,2})*(@@alt:identifierFields@@)$'
      # Exempt: the carrying element already applies the monospace treatment.
      - pattern-not:
          patterns:
            - pattern-either:
                - pattern: '<$EL ... className="$CLS" ...>{$X}</$EL>'
                - pattern: '<$EL ... className="$CLS" ... value={$X} ... />'
            - metavariable-regex:
                metavariable: $CLS
                regex: '(^|.*\s)(@@alt:monoClasses@@)(\s.*|$)'
      - pattern-not: '<$EL ... style={{..., fontFamily: $F, ...}} ...>{$X}</$EL>'
      # Exempt: an element whose own contract is the monospace one.
      - pattern-not:
          patterns:
            - pattern-either:
                - pattern: '<$EL ...>{$X}</$EL>'
                - pattern: '<$EL ... value={$X} ... />'
            - metavariable-regex:
                metavariable: $EL
                regex: '^(@@alt:monoComponents@@)$'
