# Design system: a shared visual concept has exactly one implementation. A feature folder composes
# primitives; it never defines one, and a second local pill, badge, table, empty state or skeleton
# is a duplicate rather than a variant.
#
# Generated by scripts/build-ds-rules.mjs from templates/ds-components.yml.tmpl and a design-system
# facts file (design-system.example.json); edit the facts file and rebuild instead of editing this
# file. Facts read: primitivesDir, breadcrumbFile, dataTableFile, skeletonsDir, primitiveNames,
# pillComponentNames, hitTargetClass, components.emptyState, components.skeleton.
rules:
  - id: ds-no-local-pill-or-badge
    message: >-
      Local pill/badge component `$NAME`: a pill or a badge is a primitive with exactly one
      implementation. Render the shared pill or badge primitive and pass the domain value to it,
      rather than mapping a domain value to a colour here.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@primitivesDir@@/**'
    patterns:
      - pattern-either:
          - pattern: function $NAME(...) { ... }
          - pattern: const $NAME = ...
      - metavariable-regex:
          metavariable: $NAME
          regex: '^[A-Z][a-zA-Z0-9]*(@@alt:pillComponentNames@@)$'

  - id: ds-no-primitive-name-shadow
    message: >-
      `$NAME` is the name of a primitive and is declared here instead of being imported. Each
      primitive is defined in its own module and no other module defines a component of the same
      name; a local redeclaration shadows the shared one at the import site and drifts from it.
      Import it from the primitives and delete the local copy.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@primitivesDir@@/**'
        - '@@breadcrumbFile@@'
    patterns:
      - pattern-either:
          - pattern: function $NAME(...) { ... }
          - pattern: const $NAME = ...
      - metavariable-regex:
          metavariable: $NAME
          regex: '^(@@alt:primitiveNames@@)$'

  - id: ds-use-data-table-primitive
    message: >-
      Raw table markup outside the data-table primitive. A hand-rolled table has no horizontally
      scrolling panel around it, so it scrolls the page body instead of its own panel. Compose the
      data-table primitive, which owns the scrolling panel, the header row and the semantic cells.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@dataTableFile@@'
    pattern-either:
      - pattern: <table ...>...</table>
      - pattern: <table ... />
      - pattern: createElement("table", ...)
      - pattern: $DOC.createElement("table", ...)
      - pattern: <$EL role="table" ...>...</$EL>
      - pattern: <$EL role="table" ... />
      - pattern: <$EL role="grid" ...>...</$EL>
      - pattern: <$EL role="grid" ... />

  # When a list is rendered conditionally on being non-empty, whatever renders in the other branch
  # is the empty-state primitive, the one module that carries the sentence naming what is missing
  # and the action that resolves it. An `<option>` branch (a select with a placeholder option) is
  # a form control, not a list surface.
  - id: ds-no-hand-rolled-empty-state
    message: >-
      Hand-rolled empty state: this branch renders when the list is empty, so it renders the
      `@@components.emptyState@@` primitive, not a local placeholder. Every empty list shows a specific sentence
      naming what is missing and, where an action can resolve it, a control that performs it;
      take the sentence from the catalogue and pass the control as the primitive's action.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '@@primitivesDir@@/**'
    patterns:
      - pattern-either:
          - pattern: |
              $XS.length === 0 && $EMPTY
          - pattern: |
              $XS.length === 0 ? $EMPTY : $CONTENT
          - pattern: |
              $XS.length > 0 ? $CONTENT : $EMPTY
      - metavariable-pattern:
          metavariable: $EMPTY
          patterns:
            - pattern-either:
                - pattern: <$TAG ...>...</$TAG>
                - pattern: <$TAG ... />
            - pattern-not-inside: <@@components.emptyState@@ ... />
            - pattern-not-inside: <@@components.emptyState@@ ...>...</@@components.emptyState@@>
            - pattern-not-inside: |
                <$W ...>...<@@components.emptyState@@ ... />...</$W>
            - pattern-not-inside: |
                <$W ...>...<@@components.emptyState@@ ...>...</@@components.emptyState@@>...</$W>
            - pattern-not: <option ...>...</option>
            - pattern-not: <option ... />

  # A bare skeleton bar reserves no layout: everything below it jumps when the request settles.
  - id: ds-unconfigured-skeleton
    message: >-
      An unconfigured `<@@components.skeleton@@ />` reserves no layout: the placeholder holds the space its
      content will take, so nothing jumps when the request settles. Render the layout-preserving
      skeleton for the shape that is loading (table, card list, panel); a bare skeleton bar is
      only ever a sized building block inside one of those.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@skeletonsDir@@/**'
    patterns:
      - pattern-either:
          - pattern: <@@components.skeleton@@ />
          - pattern: <@@components.skeleton@@></@@components.skeleton@@>
      - pattern-not: <@@components.skeleton@@ $ATTR={...} ... />
      - pattern-not: <@@components.skeleton@@ $ATTR="..." ... />
      - pattern-not: <@@components.skeleton@@ $ATTR={...} ...></@@components.skeleton@@>
      - pattern-not: <@@components.skeleton@@ $ATTR="..." ...></@@components.skeleton@@>

  # A disclosure summary is a primary interactive control and carries the hit-target class.
  - id: ds-summary-without-hit-target
    message: >-
      A `<summary>` without the hit-target class. A disclosure summary is a primary interactive
      control and carries the minimum touch target (WCAG 2.2 SC 2.5.8). Add the `@@hitTargetClass@@`
      class, which defines the height once; never write the size at the call site.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
    patterns:
      - pattern-either:
          - pattern: <summary ...>...</summary>
          - pattern: <summary ... />
      - pattern-not: <summary ... className="$C" ...>...</summary>
      - pattern-not: <summary ... className={$C} ...>...</summary>
      - pattern-not: <summary ... className="$C" ... />
      - pattern-not: <summary ... className={$C} ... />

  - id: ds-summary-hit-target-class-missing
    message: >-
      A `<summary>` whose `className` does not include the hit-target class. A disclosure summary
      carries the minimum touch target (WCAG 2.2 SC 2.5.8); compose `@@hitTargetClass@@` into the
      `className` instead of styling the summary by hand.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
    patterns:
      - pattern-either:
          - pattern: <summary ... className="$C" ...>...</summary>
          - pattern: <summary ... className="$C" ... />
          - pattern: <summary ... className={$C} ...>...</summary>
          - pattern: <summary ... className={$C} ... />
      - metavariable-regex:
          metavariable: $C
          regex: '^(?!.*@@hitTargetClass@@).*$'
