# Design system: overlays, dismissal and tab semantics have one owner each.
#
# Generated by scripts/build-ds-rules.mjs from templates/ds-overlays.yml.tmpl and a design-system
# facts file (design-system.example.json); edit the facts file and rebuild instead of editing this
# file. Facts read: primitivesDir, modalFiles, modalNames, tabsFile, dismissalHook.name,
# dismissalHook.file, tokens.overlay.
rules:
  - id: ds-no-adhoc-modal-overlay
    message: >-
      Hand-rolled overlay: a `position: 'fixed'` style object that picks its own stacking layer
      or paints the backdrop token. Every dialog, modal and drawer renders through the modal
      primitive, which owns the single modal layer, the backdrop, and the Escape, Tab-trap and
      focus-restoration behaviour; two overlays at two depths cannot be reasoned about. Compose
      the modal primitive instead.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@modalFiles@@'
    patterns:
      - pattern: '{..., position: "fixed", ...}'
      - pattern-either:
          - pattern: '{..., zIndex: $Z, ...}'
          - patterns:
              - pattern: '{..., $KEY: "$BACKDROP", ...}'
              - metavariable-regex:
                  metavariable: $BACKDROP
                  regex: 'var\(\s*@@tokens.overlay@@'

  - id: ds-no-dialog-role-outside-modal
    message: >-
      Dialog semantics (`role="dialog"` / `role="alertdialog"` / `aria-modal`) declared outside
      the modal primitive that owns them. The modal primitive is the one `role="dialog"`,
      `aria-modal="true"` container: correct keyboard and screen-reader semantics by default, one
      place to fix them. Render through the modal primitive.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@modalFiles@@'
    patterns:
      - pattern-either:
          - patterns:
              - pattern-either:
                  - pattern: <$EL ... role="$ROLE" ...>...</$EL>
                  - pattern: <$EL ... role="$ROLE" ... />
              - metavariable-regex:
                  metavariable: $ROLE
                  regex: '^(dialog|alertdialog)$'
          - pattern: <$EL ... aria-modal=$MODAL ...>...</$EL>
          - pattern: <$EL ... aria-modal=$MODAL ... />

  - id: ds-dismissible-surface-without-shared-dismissal
    message: >-
      `$C` offers a dismissal (`onClose` / `onDismiss`) but takes no dismissal behaviour from the
      shared implementation: it neither calls the shared dismissal hook nor renders through a
      modal or panel primitive. Every surface that covers the page dismisses on Escape, confines
      Tab while it is open and returns focus on close to the control that opened it, and that
      behaviour is shared rather than written again per overlay. Compose the panel or modal
      primitive, or call the shared dismissal hook when the surface is its own container.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@primitivesDir@@/**'
    patterns:
      - pattern-either:
          - pattern: 'function $C({..., onClose, ...}: $P) { ... }'
          - pattern: 'function $C({..., onDismiss, ...}: $P) { ... }'
          - pattern: 'const $C = ({..., onClose, ...}: $P) => { ... }'
          - pattern: 'const $C = ({..., onDismiss, ...}: $P) => { ... }'
          - pattern: 'function $C({..., onClose, ...}) { ... }'
          - pattern: 'function $C({..., onDismiss, ...}) { ... }'
          - pattern: 'const $C = ({..., onClose, ...}) => { ... }'
          - pattern: 'const $C = ({..., onDismiss, ...}) => { ... }'
      # A React component, not a helper that happens to take a callback.
      - metavariable-regex:
          metavariable: $C
          regex: '^[A-Z]'
      # Exempt: the surface takes the behaviour from the shared hook, or delegates to a primitive
      # that owns it. A range-scoped regex: the structural form is quadratic on a long component
      # and a semgrep timeout drops findings silently.
      - pattern-not-regex: '@@dismissalHook.name@@\(|<(@@alt:modalNames@@)[\s/>]'
      # Exempt: an in-flow form that paints no covering layer of its own.
      - pattern-not:
          patterns:
            - pattern-either:
                - pattern: 'function $C($X) { ... }'
                - pattern: 'const $C = ($X) => { ... }'
            - pattern-regex: '<form[\s/>]|onSubmit[=:]'
            - pattern-not-regex: 'position: *[''"]fixed[''"]|@@tokens.overlay@@'

  - id: ds-dismissal-behaviour-written-per-surface
    message: >-
      Dismissal machinery written at a surface: a document-level `keydown` listener or a
      `document.activeElement` capture is how Escape dismissal, Tab confinement and focus
      restoration are implemented, and that behaviour is shared by every surface rather than
      written again per overlay. Call the shared dismissal hook and delete the local listener.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@dismissalHook.file@@'
    patterns:
      - pattern-either:
          - pattern: 'document.addEventListener("keydown", ...)'
          - pattern: 'window.addEventListener("keydown", ...)'
          - pattern: 'document.activeElement'

  - id: ds-tab-roles-outside-primitive
    message: >-
      ARIA tab role `$ROLE` is declared outside the tab primitive. The WAI-ARIA Tabs pattern
      (roving tabindex, arrow/Home/End navigation, `aria-selected`, `aria-controls`, id
      namespacing) is implemented once, in the tab primitive; compose it instead. If this is not
      a tab set (a quick-filter or toggle chip row, where more than one option may be active and
      activating one does not swap a panel), use `role="group"` with an accessible name and
      `aria-pressed` on each toggle.
    severity: ERROR
    languages:
      - typescript
    paths:
      exclude:
        - '**/*.test.tsx'
        - '**/*.test.ts'
        - '@@tabsFile@@'
    patterns:
      - pattern-either:
          - pattern: <$EL ... role="$ROLE" ...>...</$EL>
          - pattern: <$EL ... role={"$ROLE"} ...>...</$EL>
          - pattern: '{..., role: "$ROLE", ...}'
          - pattern: $NODE.setAttribute("role", "$ROLE")
      - metavariable-regex:
          metavariable: $ROLE
          regex: ^(tab|tablist|tabpanel)$
