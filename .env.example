# Required and optional settings a deployment must provide. All values are empty here.
# Every other setting has a default or comes from the cloud profile file: docs/configuration.md.

# App: local, dev or prod.
APP_ENV=

# Database (PostgreSQL).
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_AGENT_PASSWORD=

# Graph database. GRAPH_STORE picks the backend: neo4j (default), arcadedb, postgres or tigergraph.
# URI, USER and PASSWORD are required, except for postgres without a URI (it reuses DATABASE_*).
# NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD and NEO4J_DATABASE still work for neo4j (docs/configuration.md).
GRAPH_STORE=
GRAPH_STORE_URI=
GRAPH_STORE_USER=
GRAPH_STORE_PASSWORD=
# Optional: the database (neo4j, arcadedb), schema (postgres) or graph (tigergraph); a second admin
# endpoint for backends that have one; a cap on the adapter's connection pool.
GRAPH_STORE_NAME=
GRAPH_STORE_ADMIN_URI=
GRAPH_STORE_POOL_SIZE=
# The per-backend notes live in docs/configuration.md. Each backend owns one section below.
# graph-store: neo4j
# graph-store: arcadedb
# graph-store: postgres
# With GRAPH_STORE set to postgres and no GRAPH_STORE_URI the store reuses DATABASE_* and keeps the graph in
# the schema GRAPH_STORE_NAME (default graph) of that database. An administrator creates the vector extension
# once per database (CREATE EXTENSION vector); the app role needs CREATE on the database.
# graph-store: tigergraph
# end graph-store

# Workflow engine (Temporal). The API key and TLS values are optional.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=

# LLM gateway (OpenAI-compatible route, no /v1 suffix) and the agent model id.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
AGENT_MODEL=
# Graph build models (optional). All three empty = graph build off.
GRAPH_LLM_MODEL=
GRAPH_SMALL_MODEL=
GRAPH_EMBEDDING_MODEL=

# Sign-in and frontend.
AUTH_ALLOWED_EMAIL_DOMAINS=
PUBLIC_URL=
API_INTERNAL_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=

# Document source identity, and the optional cloud profile file (unset = environment only).
DRIVE_IDENTITY_EMAIL=
SPECFLOW_CONFIG_FILE=

# Tracing (optional).
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
