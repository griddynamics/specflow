# Required and optional settings a deployment must provide. All values are empty here.
# Every other setting has a default or comes from the cloud profile file: docs/configuration.md.

# App: local, dev or prod.
APP_ENV=

# Database (PostgreSQL).
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_AGENT_PASSWORD=

# Graph database (Neo4j).
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Workflow engine (Temporal). The API key and TLS values are optional.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=

# LLM gateway (OpenAI-compatible route, no /v1 suffix) and the agent model id.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
AGENT_MODEL=
# Graph build models (optional). All three empty = graph build off.
GRAPH_LLM_MODEL=
GRAPH_SMALL_MODEL=
GRAPH_EMBEDDING_MODEL=

# Sign-in and frontend.
AUTH_ALLOWED_EMAIL_DOMAINS=
PUBLIC_URL=
API_INTERNAL_URL=
OIDC_ISSUER=
OIDC_INTERNAL_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_JWKS_URL=
SESSION_SECRET=

# Local sign-in: the bundled Keycloak (make env-local writes these; the realm is imported from them).
# Your own account (an id of the form 8-4-4-4-12 hex keeps your sign-in identity across recreates), and the
# Keycloak admin, QA-user and web-client secrets.
LOCAL_TEST_USER_EMAIL=
LOCAL_TEST_USER_PASSWORD=
LOCAL_TEST_USER_ID=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_QA_PASSWORD=
KEYCLOAK_WEB_CLIENT_SECRET=

# MCP server: the public URL of the endpoint (its path is /mcp; https outside local).
MCP_RESOURCE_URL=
# The same address and the first MCP_CLIENT_IDS entry, as the Guides page shows them (empty = PUBLIC_URL + /mcp, and specflow-mcp).
MCP_PUBLIC_URL=
MCP_CLIENT_ID=
# The server name the Guides page puts in the client commands (empty = specflow).
MCP_SERVER_NAME=

# Document source identity, and the optional cloud profile file (unset = environment only).
DRIVE_IDENTITY_EMAIL=
SPECFLOW_CONFIG_FILE=

# Tracing (optional).
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
