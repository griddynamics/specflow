# Required and optional settings a deployment must provide. All values are empty here.
# Every other setting has a default or comes from the cloud profile file: docs/configuration.md.

# App: local, dev or prod.
APP_ENV=

# Database (PostgreSQL).
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_AGENT_PASSWORD=

# Graph database. GRAPH_STORE picks the backend: neo4j (default), arcadedb, postgres or tigergraph.
# URI, USER and PASSWORD are required, except for postgres without a URI (it reuses DATABASE_*).
# NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD and NEO4J_DATABASE still work for neo4j (docs/configuration.md).
GRAPH_STORE=
GRAPH_STORE_URI=
GRAPH_STORE_USER=
GRAPH_STORE_PASSWORD=
# Optional: the database (neo4j, arcadedb), schema (postgres) or graph (tigergraph); a second admin
# endpoint for backends that have one; a cap on the adapter's connection pool.
GRAPH_STORE_NAME=
GRAPH_STORE_ADMIN_URI=
GRAPH_STORE_POOL_SIZE=
# The per-backend notes live in docs/configuration.md. Each backend owns one section below.
# The values here are for the host tools (make api, make worker, make test-graph-live). `make up` sets them
# for the containers itself: pick the store of the local stack with WITH (`make up WITH=arcadedb`,
# `make up WITH=postgres`; none = neo4j), whatever this file says.
# graph-store: neo4j
# Neo4j (GRAPH_STORE=neo4j or unset): bolt://localhost:7687 and user neo4j for the local stack. The local server
# takes GRAPH_STORE_PASSWORD as its password.
# graph-store: arcadedb
# ArcadeDB (GRAPH_STORE=arcadedb): GRAPH_STORE_URI is the Bolt endpoint (bolt://host:7687); the HTTP admin API is the
# same host on port 2480 unless GRAPH_STORE_ADMIN_URI says otherwise (http://host:2480). GRAPH_STORE_USER is root (or a
# user allowed to create types and indexes), GRAPH_STORE_NAME the database (default specflow). `make up WITH=arcadedb`
# starts a local server and creates that database; ARCADEDB_BOLT_HOST_PORT (default 7688) and ARCADEDB_HTTP_HOST_PORT (default
# 2480) are its host ports (127.0.0.1 only), ARCADEDB_DATABASE (default specflow) the database it creates.
# graph-store: postgres
# With GRAPH_STORE set to postgres and no GRAPH_STORE_URI the store reuses DATABASE_* and keeps the graph in
# the schema GRAPH_STORE_NAME (default graph) of that database. An administrator creates the vector extension
# once per database (CREATE EXTENSION vector); the app role needs CREATE on the database.
# graph-store: tigergraph
# end graph-store

# Workflow engine (Temporal). The API key and TLS values are optional.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TLS_CERT=
TEMPORAL_TLS_KEY=

# LLM gateway (OpenAI-compatible route, no /v1 suffix) and the agent model id.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
AGENT_MODEL=
# Graph build models: Build knowledge needs all three (none set = 503 graph_build_unavailable).
# make env-local asks for them. Add GRAPH_EMBEDDING_DIM, the vector size of the embedding model, together
# with GRAPH_EMBEDDING_MODEL (unset = 1536, which fits only 1536-dimension models; docs/configuration.md).
GRAPH_LLM_MODEL=
GRAPH_SMALL_MODEL=
GRAPH_EMBEDDING_MODEL=

# Sign-in and frontend.
AUTH_ALLOWED_EMAIL_DOMAINS=
PUBLIC_URL=
API_INTERNAL_URL=
OIDC_ISSUER=
OIDC_INTERNAL_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_JWKS_URL=
SESSION_SECRET=

# Local sign-in: the bundled Keycloak (make env-local writes these; the realm is imported from them).
# Your own account (an id of the form 8-4-4-4-12 hex keeps your sign-in identity across recreates), and the
# Keycloak admin, QA-user and web-client secrets.
LOCAL_TEST_USER_EMAIL=
LOCAL_TEST_USER_PASSWORD=
LOCAL_TEST_USER_ID=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_QA_PASSWORD=
KEYCLOAK_WEB_CLIENT_SECRET=

# MCP server: the public URL of the endpoint (its path is /mcp; https outside local). Set it in the api too to turn on
# the agent routes the MCP server reads through (unset there: 503 agent_unavailable).
MCP_RESOURCE_URL=
# The same address and the first MCP_CLIENT_IDS entry, as the Guides page shows them (empty = PUBLIC_URL + /mcp, and specflow-mcp).
MCP_PUBLIC_URL=
MCP_CLIENT_ID=
# The server name the Guides page puts in the client commands (empty = specflow).
MCP_SERVER_NAME=

# Document source identity, and the optional cloud profile file (unset = environment only).
DRIVE_IDENTITY_EMAIL=
SPECFLOW_CONFIG_FILE=

# Tracing (optional).
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
