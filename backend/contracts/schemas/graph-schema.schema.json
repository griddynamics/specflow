{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/contracts/schemas/graph-schema.schema.json",
  "title": "Graph schema of validation/cypher",
  "description": "backend/graph-schema.yaml in the format cypher_checks.schema reads: node labels and relationship types with their properties, uniqueness constraints and range indexes as Label.property, and the per-query policy registers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "common_label": { "$ref": "#/$defs/identifier" },
    "common_properties": { "$ref": "#/$defs/properties" },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": { "properties": { "$ref": "#/$defs/properties" } }
      }
    },
    "relationships": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/$defs/labels" },
          "to": { "$ref": "#/$defs/labels" },
          "properties": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unique": { "$ref": "#/$defs/label_properties" },
        "indexes": { "$ref": "#/$defs/label_properties" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ddl_globs": { "$ref": "#/$defs/strings" },
        "write_globs": { "$ref": "#/$defs/strings" },
        "scan_shaped_queries": { "$ref": "#/$defs/strings" },
        "banned_scan_labels": { "$ref": "#/$defs/strings" },
        "capped_traversals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query", "hard_cap", "key"],
            "properties": {
              "query": { "type": "string", "minLength": 1 },
              "hard_cap": { "type": "integer", "minimum": 1 },
              "key": { "type": "string", "minLength": 1 }
            }
          }
        },
        "create_allowed_globs": { "$ref": "#/$defs/strings" },
        "node_removals": {
          "description": "Query name to the labels and relationship types it may delete.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/strings" }
        },
        "vector_read_queries": { "$ref": "#/$defs/strings" },
        "write_allowed_globs": { "$ref": "#/$defs/strings" },
        "read_globs": { "$ref": "#/$defs/strings" },
        "read_owners": { "$ref": "#/$defs/strings" },
        "merge_scope_keys": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
        "batch_merge_queries": { "$ref": "#/$defs/strings" },
        "placeholder_labels": {
          "description": "Placeholder label or relationship type of templates to the concrete labels it stands for; parity expands a declared Placeholder.property to each of them (an empty list asks for no DDL).",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/identifier" } }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "description": "A plain Cypher identifier.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "strings": { "type": "array", "items": { "type": "string" } },
    "label_properties": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$" }
    },
    "properties": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": {
        "oneOf": [
          { "type": ["string", "null"] },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string" },
              "enum": { "type": "array", "items": { "type": "string" } }
            }
          }
        ]
      }
    }
  }
}
