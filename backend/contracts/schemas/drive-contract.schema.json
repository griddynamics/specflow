{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/contracts/schemas/drive-contract.schema.json",
  "title": "Google Drive fake and link contract",
  "description": "src/drive/fixtures/contract.json: reserved fake folder ids, folder-link parsing vectors, the category table and the processing-class order shared by the backend and the web app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reserved_folder_ids", "link_vectors", "categories", "class_order"],
  "properties": {
    "reserved_folder_ids": {
      "description": "Fake folder id to the answer the fake Drive gives for it.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^fake-[a-z0-9_-]+$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(recording|empty|forms_only|import_fails|reason:[a-z_]+)$"
      }
    },
    "link_vectors": {
      "description": "A pasted link and the folder id it yields, or null when it is rejected.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["link", "id"],
        "properties": {
          "link": { "type": "string" },
          "id": {
            "oneOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }, { "type": "null" }]
          }
        }
      }
    },
    "categories": {
      "description": "The category table in display order (drive.categories.Category, LABELS and the processing class of each).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "label", "processing_class"],
        "properties": {
          "category": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string", "minLength": 1 },
          "processing_class": { "$ref": "#/$defs/processing_class" }
        }
      }
    },
    "class_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/processing_class" }
    }
  },
  "$defs": {
    "processing_class": {
      "description": "drive.categories.ProcessingClass values.",
      "enum": ["processed", "stored_only", "skipped"]
    }
  }
}
