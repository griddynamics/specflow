{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/contracts/schemas/prefragmented-document.schema.json",
  "title": "Pre-fragmented specification document",
  "description": "tests/fixtures/specgraph/prefragmented/<name>.json: one document already split into heading-addressed fragments with their line spans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "path", "fragments"],
  "properties": {
    "document_id": { "type": "string", "pattern": "^DOC::[A-Z0-9_]+$" },
    "path": { "type": "string", "pattern": "^[^/].*\\.md$" },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragment_id", "heading_path", "line_start", "line_end", "text"],
        "properties": {
          "fragment_id": { "type": "string", "pattern": "^DOC::[A-Z0-9_]+#[a-z0-9-]+#[0-9]+$" },
          "heading_path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
