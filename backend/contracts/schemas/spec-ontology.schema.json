{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specflow.local/contracts/schemas/spec-ontology.schema.json",
  "$defs": {
    "AttributeDef": {
      "additionalProperties": false,
      "description": "One attribute; which of the optional fields apply depends on ``type`` (checked by the loader).",
      "properties": {
        "type": {
          "enum": [
            "text",
            "enum",
            "ref"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "max_chars": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Chars"
        },
        "values": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Values"
        },
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "object"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "store": {
          "default": true,
          "title": "Store",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "inherit": {
          "anyOf": [
            {
              "$ref": "#/$defs/InheritDef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type"
      ],
      "title": "AttributeDef",
      "type": "object"
    },
    "CorpusDef": {
      "additionalProperties": false,
      "properties": {
        "framing": {
          "default": "",
          "title": "Framing",
          "type": "string"
        },
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        }
      },
      "title": "CorpusDef",
      "type": "object"
    },
    "DeriveViaDef": {
      "additionalProperties": false,
      "description": "An implied edge from each module a hub is ``consumer`` of to the module it is ``provider`` of.",
      "properties": {
        "consumer": {
          "title": "Consumer",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "consumer",
        "provider"
      ],
      "title": "DeriveViaDef",
      "type": "object"
    },
    "EdgeTypeDef": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "extracted",
            "analysis",
            "human",
            "planner"
          ],
          "title": "Origin",
          "type": "string"
        },
        "tier": {
          "enum": [
            "context",
            "spec",
            "governance",
            "plan"
          ],
          "title": "Tier",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "pairs": {
          "items": {
            "$ref": "#/$defs/PairDef"
          },
          "minItems": 1,
          "title": "Pairs",
          "type": "array"
        },
        "symmetric": {
          "default": false,
          "title": "Symmetric",
          "type": "boolean"
        },
        "acyclic": {
          "default": false,
          "title": "Acyclic",
          "type": "boolean"
        },
        "stated_only": {
          "default": false,
          "title": "Stated Only",
          "type": "boolean"
        },
        "id_references": {
          "default": false,
          "title": "Id References",
          "type": "boolean"
        },
        "cues": {
          "items": {
            "type": "string"
          },
          "title": "Cues",
          "type": "array"
        },
        "derive": {
          "items": {
            "type": "string"
          },
          "title": "Derive",
          "type": "array"
        },
        "derive_via": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeriveViaDef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "origin",
        "tier",
        "pairs"
      ],
      "title": "EdgeTypeDef",
      "type": "object"
    },
    "IdDef": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "format"
      ],
      "title": "IdDef",
      "type": "object"
    },
    "IdentityDef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "id",
            "surface"
          ],
          "title": "Key",
          "type": "string"
        },
        "scope": {
          "default": "type",
          "enum": [
            "type",
            "group"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "IdentityDef",
      "type": "object"
    },
    "InferenceDef": {
      "additionalProperties": false,
      "properties": {
        "cap": {
          "exclusiveMinimum": 0,
          "title": "Cap",
          "type": "integer"
        },
        "first_cap": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Cap"
        },
        "first_budget": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Budget"
        },
        "floor": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Floor",
          "type": "number"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/InferenceRuleDef"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "cap",
        "floor"
      ],
      "title": "InferenceDef",
      "type": "object"
    },
    "InferenceRuleDef": {
      "additionalProperties": false,
      "description": "One rule; which parameters apply depends on ``template`` (checked by the loader).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "template": {
          "title": "Template",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "writes": {
          "title": "Writes",
          "type": "string"
        },
        "cap": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cap"
        },
        "first_cap": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "First Cap"
        },
        "floor": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "reads": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reads"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "members": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Members"
        },
        "via": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via"
        },
        "mentions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mentions"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "min_targets": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Targets"
        },
        "max_targets": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Targets"
        },
        "member_relation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Member Relation"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container"
        },
        "container_paths": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SpinePathDef"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Paths"
        },
        "exclude_owned_by": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude Owned By"
        },
        "targets": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targets"
        },
        "max_candidates": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Candidates"
        },
        "exclude_where": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclude Where"
        },
        "target_exclude_where": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Exclude Where"
        },
        "min_documents": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Documents"
        },
        "max_pairs": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Pairs"
        },
        "pair_floor": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pair Floor"
        },
        "also_writes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Also Writes"
        },
        "batch": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch"
        },
        "batch_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Prompt"
        }
      },
      "required": [
        "id",
        "template",
        "prompt",
        "writes"
      ],
      "title": "InferenceRuleDef",
      "type": "object"
    },
    "InheritDef": {
      "additionalProperties": false,
      "description": "Read-time inheritance: a null value is filled from the owner one ``via`` hop away.",
      "properties": {
        "via": {
          "title": "Via",
          "type": "string"
        }
      },
      "required": [
        "via"
      ],
      "title": "InheritDef",
      "type": "object"
    },
    "NodeGroupDef": {
      "additionalProperties": false,
      "description": "A node group: fields its member types inherit; never a label.",
      "properties": {
        "origin": {
          "anyOf": [
            {
              "enum": [
                "extracted",
                "analysis",
                "human",
                "planner"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "context",
                "spec",
                "governance",
                "plan"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "anchor",
                "group",
                "atomic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityDef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "guidance": {
          "default": "",
          "title": "Guidance",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/AttributeDef"
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "title": "NodeGroupDef",
      "type": "object"
    },
    "NodeTypeDef": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "extracted",
                "analysis",
                "human",
                "planner"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "context",
                "spec",
                "governance",
                "plan"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "anchor",
                "group",
                "atomic"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdDef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id_families": {
          "items": {
            "type": "string"
          },
          "title": "Id Families",
          "type": "array"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdentityDef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "merge_across_labels": {
          "default": true,
          "title": "Merge Across Labels",
          "type": "boolean"
        },
        "supported_by": {
          "items": {
            "$ref": "#/$defs/SupportDef"
          },
          "title": "Supported By",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "guidance": {
          "default": "",
          "title": "Guidance",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/AttributeDef"
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "label"
      ],
      "title": "NodeTypeDef",
      "type": "object"
    },
    "PairDef": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "default": {
          "type": "boolean",
          "default": false,
          "title": "Default"
        },
        "default_from": {
          "items": {
            "type": "string"
          },
          "title": "Default From",
          "type": "array"
        },
        "cue_required": {
          "default": false,
          "title": "Cue Required",
          "type": "boolean"
        },
        "exclusive": {
          "default": false,
          "title": "Exclusive",
          "type": "boolean"
        },
        "owner": {
          "default": false,
          "title": "Owner",
          "type": "boolean"
        },
        "owner_rank": {
          "default": 1,
          "minimum": 1,
          "title": "Owner Rank",
          "type": "integer"
        },
        "source_where": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": "Source Where",
          "type": "object"
        },
        "target_where": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": "Target Where",
          "type": "object"
        },
        "where_reason": {
          "default": "condition_failed",
          "title": "Where Reason",
          "type": "string"
        },
        "otherwise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Otherwise"
        },
        "max_depth": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth"
        },
        "not_across": {
          "items": {
            "type": "string"
          },
          "title": "Not Across",
          "type": "array"
        },
        "distinct_owner": {
          "default": false,
          "title": "Distinct Owner",
          "type": "boolean"
        },
        "redundant_via_owner": {
          "default": false,
          "title": "Redundant Via Owner",
          "type": "boolean"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "PairDef",
      "type": "object"
    },
    "SpineDef": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Roots",
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/SpinePathDef"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "exclude": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": "Exclude",
          "type": "object"
        }
      },
      "required": [
        "sources",
        "roots",
        "paths"
      ],
      "title": "SpineDef",
      "type": "object"
    },
    "SpinePathDef": {
      "additionalProperties": false,
      "description": "``{via: [...], min, max}`` or ``{sequence: [...]}``; exactly one form (checked by the loader).",
      "properties": {
        "via": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via"
        },
        "sequence": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "min": {
          "anyOf": [
            {
