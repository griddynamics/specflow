        },
        "markdown": {
          "type": "text"
        },
        "summarization": {
          "type": "text"
        },
        "summarization_status": {
          "type": "text"
        },
        "summarization_model": {
          "type": "text"
        },
        "summarization_error": {
          "type": "text"
        },
        "summarized_at": {
          "type": "timestamp"
        },
        "created_at": {
          "type": "timestamp"
        },
        "updated_at": {
          "type": "timestamp"
        }
