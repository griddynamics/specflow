          "type": "text"
        },
        "external_id": {
          "type": "text"
        },
        "link": {
          "type": "text"
        },
        "name": {
          "type": "text"
        },
        "state": {
          "type": "text"
        },
        "failure_reason": {
          "type": "text"
        },
        "connected_by": {
          "type": "uuid",
          "fk": "users.id"
