          "type": "text"
        },
        "created_by": {
          "type": "uuid",
          "fk": "users.id"
        },
        "pinned_commit_sha": {
          "type": "text"
        },
        "removed_files": {
          "type": "int"
        },
        "created_at": {
          "type": "timestamp"
        },
        "updated_at": {
          "type": "timestamp"
        }
      },
      "indexes": [
        "created_by"
      ]
    },
    "users": {
      "columns": {
        "id": {
          "type": "uuid"
        },
        "actor_id": {
          "type": "text",
          "unique": true
        },
        "display_name": {
          "type": "text"
        },
        "email": {
          "type": "text"
        },
        "auth_subject": {
          "type": "text",
          "unique": {
            "where": "auth_subject is not null"
          }
        },
        "created_at": {
          "type": "timestamp"
        }
      }
    }
  },
  "hard_delete_allowlist": [
    "connections",
    "connection_items",
    "documents"
  ],
  "append_only_tables": [],
  "orm_models": {}
}
