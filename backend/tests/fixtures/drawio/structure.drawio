<mxfile host="test">
  <diagram id="p1" name="Teams">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="L1" value="Business" parent="0"/>
        <mxCell id="L2" value="Tech" parent="0"/>
        <mxCell id="lane" value="Platform" style="swimlane;startSize=20;" vertex="1" parent="L1">
          <mxGeometry x="100" y="100" width="300" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="inner" value="Core" style="rounded=0;" vertex="1" parent="lane">
          <mxGeometry x="50" y="50" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="inner2" value="Edge" style="rounded=0;" vertex="1" parent="lane">
          <mxGeometry x="10" y="50" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="box" value="Group box" style="rounded=0;" vertex="1" parent="lane">
          <mxGeometry x="0" y="120" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="deep" value="Deep" vertex="1" parent="box">
          <mxGeometry x="5" y="5" width="50" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="top" value="Customer" vertex="1" parent="L1">
          <mxGeometry x="100" y="0" width="80" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="API" vertex="1" parent="L2">
          <mxGeometry x="500" y="100" width="80" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="calls" edge="1" parent="L1" source="top" target="inner"/>
        <mxCell id="f2" value="" edge="1" parent="L2" source="inner" target="api"/>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="Second page">
    <mxGraphModel>
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a" value="Only" vertex="1" parent="1"><mxGeometry x="0" y="0" width="10" height="10" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
